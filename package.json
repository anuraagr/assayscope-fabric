{
  "name": "assayscope-fabric",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "build:fabric": "node scripts/build-fabric.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts",
    "test": "vitest run",
    "contracts": "json2ts contracts/catalog.schema.json src/catalog.generated.d.ts --no-additionalProperties && json2ts contracts/lab-context.schema.json src/lab-context.generated.d.ts --no-additionalProperties",
    "preview": "vite preview --host 127.0.0.1",
    "fabric:doctor": "node scripts/fabric.mjs doctor",
    "fabric:plan": "node scripts/fabric.mjs plan",
    "fabric:apply": "node scripts/fabric.mjs apply",
    "fabric:smoke": "node scripts/fabric.mjs smoke",
    "fabric:cleanup": "node scripts/fabric.mjs cleanup",
    "fabric:research:plan": "node scripts/fabric.mjs research-plan",
    "fabric:research:apply": "node scripts/fabric.mjs research-apply",
    "fabric:research:run": "node scripts/fabric.mjs research-run",
    "fabric:research:status": "node scripts/fabric.mjs research-status",
    "fabric:knowledge:plan": "node scripts/fabric.mjs knowledge-plan",
    "fabric:knowledge:apply": "node scripts/fabric.mjs knowledge-apply",
    "fabric:knowledge:publish": "node scripts/fabric.mjs knowledge-publish",
    "fabric:knowledge:smoke": "node scripts/fabric.mjs knowledge-smoke",
    "fabric:knowledge:evaluate": "node scripts/fabric.mjs knowledge-evaluate",
    "docs:diagrams": "node scripts/build-diagrams.mjs",
    "repo:check": "node scripts/verify-repository.mjs",
    "test:repository": "node --test scripts/source-files.test.mjs scripts/knowledge-values.test.mjs",
    "package:source": "node scripts/package-source.mjs"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@kitware/vtk.js": "38.0.5",
    "@microsoft/rayfin-auth-provider-fabric": "1.36.2",
    "@microsoft/rayfin-client": "1.36.2",
    "@microsoft/rayfin-core": "1.36.2",
    "@microsoft/rayfin-data": "1.36.2",
    "ajv": "8.18.0",
    "ajv-formats": "3.0.1",
    "fflate": "0.8.3",
    "lucide-react": "0.468.0",
    "openseadragon": "6.1.1",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "overrides": {
    "@azure/msal-node": "7.2.1",
    "glob@>=9.0.0 <14.0.2": "14.0.3",
    "minimatch@>=7.0.0 <11.0.1": "11.0.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@microsoft/rayfin-cli": "1.36.2",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.4",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.5.0",
    "jsdom": "26.1.0",
    "json-schema-to-typescript": "15.0.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4",
    "vite": "7.3.2",
    "vitest": "4.0.18"
  }
}
