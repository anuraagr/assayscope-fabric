{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LabContextSnapshot",
  "description": "An explicit, offline LIMS/ELN export boundary. This contract does not establish a live connection.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "origin", "connectionState", "sourceSystem", "exportedAt", "sourceRights", "records"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "origin": { "enum": ["simulated", "tenant-owned-unconnected"] },
    "connectionState": { "enum": ["example-only", "authorized-export"] },
    "sourceSystem": { "type": "string", "minLength": 1, "maxLength": 120 },
    "exportedAt": { "type": "string", "format": "date-time" },
    "sourceRights": { "type": "string", "minLength": 1, "maxLength": 500 },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": { "$ref": "#/definitions/LabContextRecord" }
    }
  },
  "definitions": {
    "Identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$" },
    "LabContextRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "externalRecordId", "recordVersion", "sampleId", "batchId", "protocolId", "protocolVersion",
        "experimentId", "runId", "wellId", "sourceImageId", "replicateType", "updatedAt", "recordUrl"
      ],
      "properties": {
        "externalRecordId": { "$ref": "#/definitions/Identifier" },
        "recordVersion": { "$ref": "#/definitions/Identifier" },
        "sampleId": { "$ref": "#/definitions/Identifier" },
        "batchId": { "$ref": "#/definitions/Identifier" },
        "protocolId": { "$ref": "#/definitions/Identifier" },
        "protocolVersion": { "$ref": "#/definitions/Identifier" },
        "experimentId": { "$ref": "#/definitions/Identifier" },
        "runId": { "$ref": "#/definitions/Identifier" },
        "wellId": { "$ref": "#/definitions/Identifier" },
        "sourceImageId": { "$ref": "#/definitions/Identifier" },
        "replicateType": { "const": "technical" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "recordUrl": { "type": "string", "format": "uri", "maxLength": 500 }
      }
    }
  }
}
