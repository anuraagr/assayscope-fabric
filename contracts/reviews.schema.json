{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ResearchReviews",
  "type": "array",
  "maxItems": 1000,
  "items": { "$ref": "#/definitions/ResearchReview" },
  "definitions": {
    "ResearchReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["well_id", "state", "rationale", "annotation", "updated_at", "version"],
      "properties": {
        "well_id": { "type": "string", "pattern": "^run[12]-[A-H](0[1-9]|1[0-2])$" },
        "state": { "enum": ["Investigate", "Repeat acquisition", "Prioritize for confirmatory research"] },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "annotation": { "type": "string", "maxLength": 4000 },
        "updated_at": { "type": "string", "format": "date-time" },
        "version": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
