{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "ESNext.Decorators"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "composite": true,
    "declaration": true,
    "skipLibCheck": true,
    "outDir": ".temp/compiled",
    "rootDir": "."
  },
  "include": [
    "data/**/*.ts"
  ],
  "exclude": [
    "functions/**/*"
  ]
}
